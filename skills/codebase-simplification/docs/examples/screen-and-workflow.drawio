<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio">
  <diagram id="screen-and-workflow" name="画面の位置と、業務の状態を分ける">
    <mxGraphModel page="1" pageWidth="1080" pageHeight="710" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="画面の位置と、業務の状態を分ける" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=29;fontColor=#263238;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="1030" height="48" as="geometry" />
        </mxCell>
        <mxCell id="before" value="変更前" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#64717d;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="88" width="470" height="45" as="geometry" />
        </mxCell>
        <mxCell id="after" value="変更後" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=25;fontColor=#2154ce;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="585" y="88" width="470" height="45" as="geometry" />
        </mxCell>
        <mxCell id="screen1" value="入力画面 A / B / C" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#263238;fillColor=#f5f6f7;strokeColor=#64717d;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="163" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="state1" value="画面に対応した業務状態&lt;br&gt;入力 A 中 / B 中 / C 中" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#263238;fillColor=#fff5e8;strokeColor=#e86b10;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="335" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="history1" value="画面ごとの進行を履歴へ記録" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#263238;fillColor=#f5f6f7;strokeColor=#64717d;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="495" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="screen-state" value="各画面で保存" source="screen1" target="state1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64717d;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#64717d;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-history" value="" source="state1" target="history1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#64717d;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#64717d;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;UI が持つ&lt;/b&gt;&lt;br&gt;現在の画面 A / B / C" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#263238;fillColor=#eff4ff;strokeColor=#2154ce;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="635" y="150" width="370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="save" value="通常の保存&lt;br&gt;入力内容を更新" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#263238;fillColor=#eff4ff;strokeColor=#2154ce;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="635" y="277" width="370" height="85" as="geometry" />
        </mxCell>
        <mxCell id="operation" value="&lt;b&gt;業務操作&lt;/b&gt;&lt;br&gt;承認依頼" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#263238;fillColor=#eff4ff;strokeColor=#2154ce;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="585" y="455" width="170" height="105" as="geometry" />
        </mxCell>
        <mxCell id="business" value="&lt;b&gt;業務状態・履歴&lt;/b&gt;&lt;br&gt;作成中 → 承認待ち" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#263238;fillColor=#eff4ff;strokeColor=#2154ce;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="805" y="455" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ui-save" value="" source="ui" target="save" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2154ce;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#2154ce;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="operation-business" value="" source="operation" target="business" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2154ce;strokeWidth=2;fontFamily=Helvetica;fontSize=20;fontColor=#2154ce;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="effect" value="画面の追加・並べ替えと、業務の状態遷移を切り離せる" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#263238;fillColor=#edf8f5;strokeColor=#16756a;strokeWidth=2;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="25" y="641" width="1030" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>